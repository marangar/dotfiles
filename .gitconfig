[diff]
    tool = vimdiff
[difftool]
    prompt = false
# git-delta settings
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true    # use n and N to move between diff sections
    side-by-side = true
    line-numbers = true
    features = weeping-willow
[include]
    path = ~/.config/delta-themes.gitconfig
[merge]
    conflictstyle = zdiff3
[alias]
    l = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
    a = add
    c = commit -a -m
    d = diff
    s = status -s
    sh = show
    co = checkout
    ps = push
    pl = pull
    dd = "!git diff --name-only | fzf --preview 'git -c core.pager=cat diff --color=always -- {}' --preview-window=right:70% --bind 'enter:execute(git --no-pager diff -U10 -- {} | delta --paging=always)'"
